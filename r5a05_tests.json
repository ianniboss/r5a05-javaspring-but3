{
  "info": {
    "_postman_id": "r5a05-spring-security-jwt-tests",
    "name": "R5A05 - Spring Security Auth & Permissions Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public - GET /bonjour",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/bonjour",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["bonjour"]
        }
      }
    },
    {
      "name": "2. Unauthenticated - GET /joueurs (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/joueurs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["joueurs"]
        }
      }
    },
    {
      "name": "3. Auth - Login as USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login user successful 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a('string');",
              "    pm.environment.set(\"user_token\", jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"user\",\n    \"password\": \"user123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "4. Read Permission - GET /joueurs as USER (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"USER can read joueurs (200 OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/joueurs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["joueurs"]
        }
      }
    },
    {
      "name": "5. Write Permission - POST /joueurs as USER (Expect 403 Forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"USER cannot create joueur (403 Forbidden)\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nom\": \"Mbappe\",\n    \"prenom\": \"Kylian\",\n    \"poste\": \"Attaquant\",\n    \"actif\": true\n}"
        },
        "url": {
          "raw": "http://localhost:8080/joueurs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["joueurs"]
        }
      }
    },
